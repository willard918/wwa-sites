# Copy to env.production and fill in. Never commit the real file.
WWA_BASE_URL=https://pacificnestadu.com
WWA_DATA=/data
WWA_TRUST_PROXY=1
WWA_FROM=Willard Williams Architect <willardw@willardwilliamsarchitect.com>
# A real street address or PO box: real sending is refused until this is set.
WWA_POSTAL=
# Where new-lead alerts go (default: the From address)
WWA_NOTIFY=
# Leave SMTP empty to keep emails in the outbox only. Use a transactional provider (Postmark, SES, Resend...).
WWA_SMTP_HOST=
WWA_SMTP_PORT=587
WWA_SMTP_USER=
WWA_SMTP_PASS=
